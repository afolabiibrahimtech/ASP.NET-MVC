@model StudentEnrollment.Models.Course

@{
    ViewData["Title"] = "Delete Course";
}

<h1>Delete Course</h1>

<h3>Are you sure you want to delete this course?</h3>

<div class="mb-3">
    <dl class="row">
        <dt class="col-sm-3">Id</dt>
        <dd class="col-sm-9">@Model.Id</dd>

        <dt class="col-sm-3">CourseCode</dt>
        <dd class="col-sm-9">@Model.CourseCode</dd>

        <dt class="col-sm-3">CourseName</dt>
        <dd class="col-sm-9">@Model.CourseName</dd>

        <dt class="col-sm-3">Instructor</dt>
        <dd class="col-sm-9">@Model.Instructor</dd>

        <dt class="col-sm-3">Credit Hours</dt>
        <dd class="col-sm-9">@Model.CreditHours</dd>
    </dl>
</div>

<form asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Confirm Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>