@{
    ViewData["Title"] = "Home";

    var demoUser =
        Context.Session.GetString("DemoUser");
}

<h1>Home</h1>

@if (!string.IsNullOrEmpty(demoUser))
{
    <p>
        Hello, @demoUser.
        The demo session value is present.
    </p>
}
else
{
    <p>
        You are not signed in to the classroom demo.
    </p>

    <a asp-controller="Account"
       asp-action="Login"
       class="btn btn-primary">
        Login
    </a>
}