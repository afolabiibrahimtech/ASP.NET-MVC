//Example 3 ==============================================

@model studentmvc.ViewModels.StudentCourseViewModel
<h2>Student and Course list</h2>
<h2>Student List</h2>
   <table class="table table-dark" border="1">

   <tr>
      <th> ID</th>
      <th>Name</th>
      <th>Age</th>
   </tr>
   @foreach(var student in Model.students)
   {
       <tr>
         <td>@student.Id</td>
         <td>@student.Name</td>
         <td>@student.Age</td>
      </tr>
   }
  
   </table>
   <h2>Course List</h2>
   <table class="table table-dark" border="1">

   <tr>
      <th> ID</th>
      <th>Name</th>
      <th>Credit</th>
      <th>Description</th>
   </tr>
   @foreach(var course in Model.courses)
   {
       <tr>
         <td>@course.Id</td>
         <td>@course.Name</td>
         <td>@course.Credit</td>
         <td>@course.Description</td>
      </tr>
   }
  
   </table>

