@model IEnumerable<Course>

@{
    ViewData["Title"] = "Course Management";
}

<link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.bootstrap5.min.css" />

<div class="body-text page-content">
    <div class="text-center shadow-text">
        <h1>Course Management</h1>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }

    <p>
        <a asp-action="Create" class="btn btn-primary">Add Course</a>
    </p>

    <table id="coursesTable" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(m => m.CourseCode)</th>
                <th>@Html.DisplayNameFor(m => m.CourseName)</th>
                <th>@Html.DisplayNameFor(m => m.Description)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var course in Model)
            {
                <tr>
                    <td>@course.CourseCode</td>
                    <td>@course.CourseName</td>
                    <td>@course.Description</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@course.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/2.1.8/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.1.8/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(function () {
            $('#coursesTable').DataTable({
                order: [[0, 'asc']],
                columnDefs: [
                    { targets: -1, orderable: false, searchable: false }
                ]
            });
        });
    </script>
}